# ============================================================
# BabaSTI Hosting - Client Platform Environment
# Copy this file to `.env` and adjust values for your setup.
# NEVER commit real secrets. This file contains placeholders only.
# ============================================================

# ---- Core ----
NODE_ENV=development

# ---- Database ----
DATABASE_URL="postgresql://babasti:babasti_dev_password@localhost:5432/babasti?schema=public"

# ---- API Server ----
API_PORT=3000
API_HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
# Session cookie age in seconds (default 7 days)
SESSION_TTL=604800

# ---- CORS / Cookies ----
# Set to "true" only when serving the client from a different origin over HTTPS.
COOKIE_SECURE=false

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ---- GitHub OAuth (for GitHub deployments) ----
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/github/callback"

# ---- Deployment Provider ----
# "mock" for local development without real infrastructure.
# "real" when connecting the Node Agent to real hosting nodes.
DEPLOYMENT_PROVIDER=mock

# ---- Hosting Node / Node Agent ----
# Base URL(s) of registered node agents (comma separated). Used only by the Real provider.
NODE_AGENT_URL="http://localhost:4000"
# Shared secret used by the control plane to authenticate node agents.
NODE_AGENT_TOKEN="change-me-node-agent-token"

# ---- Storage ----
# Local directory where uploaded artifacts / releases are staged.
STORAGE_PATH="./data/storage"
# Storage root for agent-managed releases (control plane -> node agent).
# Falls back to STORAGE_PATH when unset.
AGENT_STORAGE=""

# ---- Control Plane URL ----
# Public base URL the Node Agent uses to reach the control plane
# (download artifacts, report deploy status/logs). Used by the Real provider.
CONTROL_PLANE_URL="http://localhost:3000"

# ---- Queue ----
# Leave empty to use the in-memory queue. Provide a Redis URL to enable Redis-backed queue.
REDIS_URL=""

# ---- Frontend ----
# Used by the client app at build time (VITE_ prefix is exposed to the browser).
VITE_API_URL="http://localhost:3000/api"
VITE_DEFAULT_DOMAIN_SUFFIX="babasti.my.id"

# ---- Domain ----
# Wildcard base domain used to generate default subdomains.
DEFAULT_DOMAIN_SUFFIX="babasti.my.id"
