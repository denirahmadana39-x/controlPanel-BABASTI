# ============================================================
# BabaSTI Hosting - Client Platform Environment
# Copy this file to `.env` and adjust values for your setup.
# NEVER commit real secrets. This file contains placeholders only.
# ============================================================

# ---- Core ----
NODE_ENV=development

# ---- Database ----
DATABASE_URL="postgresql://babasti:babasti_dev_password@localhost:5432/babasti?schema=public"

# ---- API Server ----
API_PORT=3000
API_HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
# Session cookie age in seconds (default 7 days)
SESSION_TTL=604800

# ---- CORS / Cookies ----
# Set to "true" only when serving the client from a different origin over HTTPS.
COOKIE_SECURE=false

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ---- GitHub OAuth (for GitHub deployments) ----
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/github/callback"

# ---- Deployment Provider ----
# "mock" for local development without real infrastructure.
# "real" when connecting the Node Agent to real hosting nodes.
DEPLOYMENT_PROVIDER=mock

# ---- Hosting Node / Node Agent ----
# Legacy single-node fallback. Multi-node installations use each registered
# node's PUBLIC_AGENT_URL instead.
NODE_AGENT_URL="http://localhost:4000"
# Unique agent credential on each hosting node. For a multi-node control plane,
# this value is only a backwards-compatible fallback.
NODE_AGENT_TOKEN="change-me-node-agent-token"
# Bootstrap credential shared only for registering new nodes. It should differ
# from every NODE_AGENT_TOKEN.
NODE_REGISTRATION_TOKEN="change-me-node-registration-token"
NODE_HEARTBEAT_INTERVAL_SECONDS=30
NODE_HEARTBEAT_TTL_SECONDS=90

# Identity advertised by each Node Agent.
NODE_NAME="proxmox-node-1"
PUBLIC_AGENT_URL="http://node-agent:4000"
AGENT_PORT=4000
# Per-node Cloudflare Tunnel CNAME target, not an API token.
CLOUDFLARE_TUNNEL_TARGET="00000000-0000-0000-0000-000000000000.cfargotunnel.com"

# ---- Storage ----
# Local directory where uploaded artifacts / releases are staged.
STORAGE_PATH="./data/storage"
# Storage root for agent-managed releases (control plane -> node agent).
# Falls back to STORAGE_PATH when unset.
AGENT_STORAGE=""
# nginx directory included by the node's main nginx configuration. Required in
# production real-provider mode; /etc/nginx/conf.d is typical on Ubuntu.
AGENT_NGINX_CONFIG_DIR="/etc/nginx/conf.d"
AGENT_NGINX_BINARY="nginx"

# ---- Control Plane URL ----
# Public base URL the Node Agent uses to reach the control plane
# (download artifacts, report deploy status/logs). Used by the Real provider.
CONTROL_PLANE_URL="http://localhost:3000"

# ---- Queue ----
# Leave empty to use the in-memory queue. Provide a Redis URL to enable Redis-backed queue.
REDIS_URL=""

# ---- Mini plan limits ----
MAX_WEBSITES_PER_USER=3
MAX_DEPLOYMENTS_PER_DAY=10
MAX_CONCURRENT_DEPLOYMENTS_PER_USER=1
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTED_BYTES=262144000

# ---- Frontend ----
# Used by the client app at build time (VITE_ prefix is exposed to the browser).
VITE_API_URL="http://localhost:3000/api"
VITE_DEFAULT_DOMAIN_SUFFIX="babasti.my.id"

# ---- Domain ----
# Wildcard base domain used to generate default subdomains.
DEFAULT_DOMAIN_SUFFIX="babasti.my.id"

# ---- Cloudflare DNS automation (control plane only) ----
# Token needs Zone / DNS / Edit for the babasti.my.id zone only.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_DNS_PROXIED=true

# ---- Cloudflare Access service token (optional) ----
# Use only when the private Agent hostnames and/or control-plane internal
# endpoint are protected by Cloudflare Access. Both values must be set together.
CLOUDFLARE_ACCESS_CLIENT_ID=""
CLOUDFLARE_ACCESS_CLIENT_SECRET=""
