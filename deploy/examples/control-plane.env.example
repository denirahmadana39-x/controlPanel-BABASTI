# Install as /etc/babasti/control-plane.env and replace every CHANGE_ME value.
# Keep mode 0600. Never commit the populated file.
NODE_ENV=production
DATABASE_URL=postgresql://babasti:CHANGE_ME@10.30.30.123:5432/babasti?schema=public
API_HOST=0.0.0.0
API_PORT=3000
CLIENT_URL=https://panel.babasti.my.id
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_LONG_RANDOM_VALUE
COOKIE_SECURE=true
DEPLOYMENT_PROVIDER=real
NODE_REGISTRATION_TOKEN=CHANGE_ME_REGISTRATION_ONLY_VALUE
NODE_HEARTBEAT_INTERVAL_SECONDS=30
NODE_HEARTBEAT_TTL_SECONDS=90
CONTROL_PLANE_URL=https://api.babasti.my.id
REDIS_URL=redis://10.30.30.123:6379
STORAGE_PATH=/var/lib/babasti/artifacts
MAX_WEBSITES_PER_USER=3
MAX_DEPLOYMENTS_PER_DAY=10
MAX_CONCURRENT_DEPLOYMENTS_PER_USER=1
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTED_BYTES=262144000
DEFAULT_DOMAIN_SUFFIX=babasti.my.id
CLOUDFLARE_ZONE_ID=CHANGE_ME_ZONE_ID
CLOUDFLARE_API_TOKEN=CHANGE_ME_ZONE_SCOPED_DNS_WRITE_TOKEN
CLOUDFLARE_DNS_PROXIED=true
# Optional; set both only if Agent hostnames require a Cloudflare Access service token.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
