[Unit]
Description=BabaSTI Hosting control-plane API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=babasti
Group=babasti
WorkingDirectory=/opt/babasti/current
EnvironmentFile=/etc/babasti/control-plane.env
ExecStart=/usr/bin/node apps/api/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/babasti

[Install]
WantedBy=multi-user.target
