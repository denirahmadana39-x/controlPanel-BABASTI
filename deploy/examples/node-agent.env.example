# Make one copy per node at /etc/babasti/node-agent.env. Keep mode 0600.
NODE_ENV=production
DATABASE_URL=postgresql://unused:unused@127.0.0.1:5432/unused
SESSION_SECRET=unused-but-at-least-16-characters
DEPLOYMENT_PROVIDER=real
API_HOST=0.0.0.0
AGENT_PORT=4000
NODE_NAME=CHANGE_ME_NODE_NAME
PUBLIC_AGENT_URL=https://CHANGE_ME_AGENT_HOSTNAME
NODE_AGENT_TOKEN=CHANGE_ME_UNIQUE_PER_NODE_VALUE
NODE_REGISTRATION_TOKEN=CHANGE_ME_SAME_REGISTRATION_VALUE_AS_CONTROL_PLANE
NODE_HEARTBEAT_INTERVAL_SECONDS=30
CONTROL_PLANE_URL=https://api.babasti.my.id
STORAGE_PATH=/var/lib/babasti-agent
AGENT_STORAGE=/var/lib/babasti-agent
AGENT_NGINX_CONFIG_DIR=/etc/nginx/babasti-sites.d
AGENT_NGINX_BINARY=/usr/sbin/nginx
CLOUDFLARE_TUNNEL_TARGET=CHANGE_ME_TUNNEL_UUID.cfargotunnel.com
# Optional; set both only when the destination is protected by Access.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
